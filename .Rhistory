library(ggplot2)
library(patchwork)  # for combining plots
library(reshape2)
cor_matrix <- matrix(
c(0.7533243, -0.51068812,
-0.3879228, 0.07312667,
0.6322800, -0.84577223),
nrow = 3, byrow = TRUE,
dimnames = list(c("HEU_class1","HEU_class2","HEU_class3"),
c("HUU_class1","HUU_class2"))
)
cor_df <- melt(cor_matrix, varnames = c("HUU_class","HEU_class"), value.name = "correlation")
heat <- ggplot(cor_df, aes(x = HEU_class, y = HUU_class, fill = correlation)) +
geom_tile(color = "white") +
geom_text(aes(label = round(correlation, 2)), size = 4) +
scale_fill_gradient2(low = "steelblue", mid = "white", high = "firebrick",
midpoint = 0, limits = c(-1, 1)) +
labs(title = "Class Alignment Correlation", x = NULL, y = NULL) +
theme_minimal(base_size = 11) +
theme(legend.position = "right",
axis.text.x = element_text(angle = 0))
# Main trajectory plot (your existing one)
main_plot <- ggplot(all_traj, aes(x = agemos, y = pred, color = class, linetype = group)) +
geom_line(linewidth = 1.1) +
labs(title = "Predicted Trajectories by Latent Class (HUU vs HEU)",
x = "Age (months)", y = "Predicted Height for age z-score (HAZ)",
color = "Class", linetype = "Group") +
theme_minimal(base_size = 13)
